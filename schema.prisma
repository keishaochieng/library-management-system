generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   // NEW: bcrypt hash
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())

  reviews   Review[]
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique

  books Book[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  isbn            String   @unique // NEW
  totalCopies     Int      // NEW
  publishedYear   Int?
  copiesAvailable Int      @default(1)
  createdAt       DateTime @default(now())

  genreId         Int
  genre           Genre    @relation(fields: [genreId], references: [id])

  reviews         Review[]

  @@unique([title, author])
  @@index([genreId])
}

// Stretch task
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
}
